# Server
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smarthome_iot

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES=24h

# MQTT Broker
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=SmartHome_BE_Client
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# MQTT Topics
MQTT_TOPIC_SENSOR=Sensor/thh
MQTT_TOPIC_CONTROL=Device_control/thh
MQTT_TOPIC_RESPOND=Device_respond/thh

# Fake Data Simulator (dùng khi không có mạch cảm biến phần cứng)
SIMULATOR_AUTO_START=false
SIMULATOR_INTERVAL_MS=3000
